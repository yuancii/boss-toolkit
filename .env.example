# 复制为 .env 后填入自己的 Key（.env 已被 .gitignore 忽略，不会入库）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：接入真实 MySQL（tools_mysql.py / daily_report.py 使用，建议只读账号）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=reader
MYSQL_PASSWORD=change-me
MYSQL_DB=business
